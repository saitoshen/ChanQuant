# 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
.mplcache/
.pytest_cache/

# 打包中间产物（dist/ 里是要分发的成品，按需决定是否提交）
build/
dist/
*.spec.bak

# 回测输出（由 backtest_all.py 生成，可随时重建）
output/

# 数据目录的本地备份（排查/验证时临时拷的，不入库）
data*.bak*/
data*.bak_*/

# 真实合约与期权原始明细：约 130MB / 1.5GB，用 download_aux.py 重新生成，
# 不入库也不打进安装包。聚合后的 data_futures_aux/ 很小，需要入库。
data_contracts/
data_options_raw/

# 工具内部的工作记忆，不属于项目源码
.workbuddy-ai/

# 密钥：Tushare token 走环境变量或本地文件，绝不入库
token.txt
*token*.local
.env

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
